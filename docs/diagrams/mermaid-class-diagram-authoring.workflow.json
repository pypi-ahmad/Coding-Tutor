  "cards": [
    {
      "dot": "violet",
      "title": "Classes and members",
      "items": [
        "Declare classes or introduce them by relation; attributes omit (), methods include ().",
        "Generic types use ~ delimiters; return types follow the closing ).",
        "Visibility: public +, private -, protected #, package/internal ~.",
        "Abstract methods end with *; static members end with $."
      ]
    },
    {
      "dot": "cyan",
      "title": "Relationship Vocabulary",
      "items": [
        "Inheritance, composition, aggregation, association, and solid link",
        "Dependency, realization, dashed link, two-way relations, and lollipop interfaces",
        "Labels explain intent; quoted endpoint values express multiplicity"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grouping + Presentation",
      "items": [
        "Namespaces group classes and support hierarchical nesting in Mermaid 11.15+",
        "Notes may target the diagram or one class",
        "Styles and reusable classes control appearance",
        "Links and callbacks require a compatible security level"
      ]
    }
