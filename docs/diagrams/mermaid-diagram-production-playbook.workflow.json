{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Mermaid Diagram Production Playbook",
    "subtitle": "Choose, author, validate, and deliver Mermaid diagrams",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "viewBox": [920, 466]
  },
  "lanes": [
    { "id": "authoring", "label": "Core Workflow" },
    { "id": "recovery", "label": "Validation Recovery", "variant": "exception" },
    { "id": "guidance", "label": "On-Demand Guidance" }
  ],
  "phases": [
    { "id": "scope", "label": "Scope", "fromCol": 0, "toCol": 1 },
    { "id": "author", "label": "Author", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "assure", "label": "Assure", "fromCol": 4, "toCol": 4, "variant": "security" },
    { "id": "handoff", "label": "Handoff", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["scope_request", "choose_type", "build_source", "save_file", "validate_cli", "report_output"],
  "nodes": [
    { "id": "scope_request", "lane": "authoring", "col": 0, "type": "external", "label": "Scope", "sublabel": "intent", "width": 36 },
    { "id": "choose_type", "lane": "authoring", "col": 1, "type": "backend", "label": "Choose", "sublabel": "grammar", "width": 44 },
    { "id": "build_source", "lane": "authoring", "col": 2, "type": "backend", "label": "Build", "sublabel": "Mermaid", "width": 44 },
    { "id": "save_file", "lane": "authoring", "col": 3, "type": "database", "label": "Save", "sublabel": ".mmd", "width": 36 },
    { "id": "validate_cli", "lane": "authoring", "col": 4, "type": "security", "label": "Check", "sublabel": "mmdc", "width": 36 },
    { "id": "report_output", "lane": "authoring", "col": 5, "type": "frontend", "label": "Report", "sublabel": "paths", "width": 44 },
    { "id": "read_error", "lane": "recovery", "col": 3, "type": "security", "label": "Read", "sublabel": "error", "width": 36 },
    { "id": "repair_source", "lane": "recovery", "col": 4, "type": "messagebus", "label": "Fix", "sublabel": "retry", "width": 36 },
    { "id": "examples", "lane": "guidance", "col": 1, "type": "database", "label": "Examples", "sublabel": "by type", "width": 60 },
    { "id": "templates", "lane": "guidance", "col": 2, "type": "database", "label": "Patterns", "sublabel": "on demand", "width": 60 }
  ],
  "edges": [
    { "id": "scope-choose", "from": "scope_request", "to": "choose_type", "role": "main", "variant": "emphasis" },
    { "id": "choose-build", "from": "choose_type", "to": "build_source", "role": "main", "variant": "emphasis" },
    { "id": "build-save", "from": "build_source", "to": "save_file", "role": "main", "variant": "emphasis" },
    { "id": "save-check", "from": "save_file", "to": "validate_cli", "role": "main", "variant": "security", "route": "straight" },
    { "id": "check-report", "from": "validate_cli", "to": "report_output", "role": "main", "variant": "emphasis" },
    { "id": "check-error", "from": "validate_cli", "to": "read_error", "role": "error", "variant": "security", "fromSide": "bottom", "toSide": "right", "via": [[500,160],[466,160],[466,243]] },
    { "id": "error-fix", "from": "read_error", "to": "repair_source", "role": "branch", "variant": "security", "route": "straight" },
    { "id": "fix-recheck", "from": "repair_source", "to": "validate_cli", "role": "return", "variant": "dashed" },
    { "id": "examples-choose", "from": "examples", "to": "choose_type", "role": "async", "variant": "dashed" },
    { "id": "templates-build", "from": "templates", "to": "build_source", "role": "async", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Supported families",
      "items": [
        "Core: flowchart, sequence, class, state, ER, Gantt, journey, timeline, Kanban.",
        "Data: pie, XY, quadrant, Sankey, radar, treemap.",
        "Other: Git, C4, requirements, architecture, block, packet, mindmap, ZenUML."
      ]
    },
    {
      "dot": "violet",
      "title": "Code analysis mapping",
      "items": [
        "Class: types, members, inheritance, interfaces, ownership.",
        "Sequence: calls, async work, APIs, activations.",
        "Flowchart: branches, loops, entries, exits; state: event-driven transitions."
      ]
    },
    {
      "dot": "emerald",
      "title": "Readable, validated output",
      "items": [
        "Use clear IDs, labels, subgraphs, classes, and direction; split dense views.",
        "Load relevant examples; explain complex sections.",
        "Run Mermaid CLI on saved .mmd; repair and rerun until it passes.",
        "Render SVG/PNG/PDF only on request; report paths and true status."
      ]
    }
  ]
}
