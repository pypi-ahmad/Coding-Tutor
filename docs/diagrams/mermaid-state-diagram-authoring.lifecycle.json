{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Mermaid State Diagram Authoring Map",
    "subtitle": "Define finite states, connect transitions, add hierarchical behavior, and finish with readable presentation",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [980, 900]
  },
  "lanes": [
