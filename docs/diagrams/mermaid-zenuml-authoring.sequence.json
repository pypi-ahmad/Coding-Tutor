    { "participant": "store", "from": 384, "to": 532, "type": "database" },
    { "participant": "worker", "from": 428, "to": 458, "type": "messagebus" },
    { "participant": "renderer", "from": 588, "to": 698, "type": "cloud" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Participants",
      "items": [
        "Participants may be implicit or explicitly ordered before the first message.",
        "Aliases separate compact identifiers from descriptive labels.",
        "Annotators select participant symbols such as Actor or Database."
      ]
    },
    {
      "dot": "violet",
      "title": "Messages and nesting",
      "items": [
        "ZenUML supports synchronous, asynchronous, creation, and reply messages.",
        "Synchronous and creation messages can contain nested interactions in braces.",
        "Replies use assignment, return, or the return/reply annotator."
      ]
    },
    {
      "dot": "amber",
      "title": "Control fragments",
      "items": [
        "Loops include while, for, forEach, foreach, and loop.",
        "Conditional, optional, parallel, and try/catch/finally blocks use braces.",
        "Message-level comments use double slashes and support Markdown."
      ]
    },
    {
      "dot": "emerald",
      "title": "Web integration",
      "items": [
        "ZenUML is loaded through Mermaid's external-diagram registration API.",
        "Import Mermaid and the ZenUML module before calling registerExternalDiagrams.",
        "The renderer uses experimental lazy loading and asynchronous rendering."
      ]
    }
  ]
}
