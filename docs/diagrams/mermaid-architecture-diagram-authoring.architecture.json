      "dot": "cyan",
      "title": "Core declarations",
      "items": [
        "Declare identifiers before another component references them.",
        "Place icons in parentheses and display labels in brackets.",
        "Use in to place groups or services inside a parent group."
      ]
    },
    {
      "dot": "violet",
      "title": "Connection semantics",
      "items": [
        "Choose T, B, L, or R ports on both ends of every edge.",
        "Add arrowheads to show direction; use junctions for shared routes.",
        "Use the group modifier for edges that cross group boundaries."
      ]
    },
    {
      "dot": "amber",
      "title": "Placement and rendering",
      "items": [
        "Align rows for vertical port pairs and columns for horizontal port pairs.",
        "Combine row and column constraints for grids without contradictory ordering.",
        "Use a nonzero seed for reproducible fCoSE placement."
      ]
    },
    {
      "dot": "emerald",
      "title": "Icon support",
      "items": [
        "Built-ins are cloud, database, disk, internet, and server.",
        "Register an icon pack before using a namespaced custom icon.",
        "Keep labels short or increase iconSize when a label cannot wrap cleanly."
