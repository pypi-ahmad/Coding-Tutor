{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Mermaid Flowcharts",
    "subtitle": "Nodes, links, groups, styling, and rendering",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [920, 466]
  },
  "lanes": [
    { "id": "core", "label": "Declare and Define" },
    { "id": "details", "label": "Links and Composition" },
    { "id": "output", "label": "Interaction and Output" }
  ],
  "phases": [
    { "id": "foundation", "label": "Foundation", "fromCol": 0, "toCol": 1 },
    { "id": "topology", "label": "Topology", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "finish", "label": "Compose + finish", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "declare",
    "direction",
    "nodes"
  ],
  "nodes": [
    {
      "id": "declare",
      "lane": "core",
      "col": 0,
      "type": "frontend",
      "label": "Declare",
      "sublabel": "flowchart or graph"
    },
    {
      "id": "direction",
      "lane": "core",
      "col": 2,
      "type": "backend",
      "label": "Direction",
      "sublabel": "TB · TD · BT · RL · LR"
    },
    {
      "id": "nodes",
      "lane": "core",
      "col": 4,
      "type": "database",
      "label": "Nodes",
      "sublabel": "IDs, labels, and shapes"
    },
    {
      "id": "edges",
      "lane": "details",
      "col": 4,
      "type": "messagebus",
      "label": "Edges",
      "sublabel": "links + labels"
    },
    {
      "id": "subgraphs",
      "lane": "details",
      "col": 2,
      "type": "cloud",
      "label": "Subgraphs",
      "sublabel": "group related topology"
    },
    {
      "id": "styles",
      "lane": "details",
      "col": 0,
      "type": "frontend",
      "label": "Style",
      "sublabel": "classDef and curves"
    },
    {
      "id": "interaction",
      "lane": "output",
      "col": 0,
      "type": "external",
      "label": "Interaction",
      "sublabel": "clicks + tooltips"
    },
    {
      "id": "render",
      "lane": "output",
      "col": 2,
      "type": "cloud",
      "label": "Render",
      "sublabel": "Dagre or ELK"
    }
  ],
  "edges": [
    { "id": "declare_direction", "from": "declare", "to": "direction", "role": "main" },
    { "id": "direction_nodes", "from": "direction", "to": "nodes", "role": "main", "route": "straight" },
    { "id": "nodes_edges", "from": "nodes", "to": "edges", "role": "main", "variant": "emphasis" },
    { "id": "edges_subgraphs", "from": "edges", "to": "subgraphs", "role": "main" },
    { "id": "subgraphs_styles", "from": "subgraphs", "to": "styles", "role": "main" },
    { "id": "styles_interaction", "from": "styles", "to": "interaction", "role": "main" },
    { "id": "interaction_render", "from": "interaction", "to": "render", "role": "main", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "Semantic Shape Families",
      "items": [
        "Process, decision, event, start, stop, and subprocess",
        "Database, datastore, document, storage, input, and output",
        "Cloud, browser, console, person, comment, icon, and image",
        "Expanded shape metadata syntax is available in Mermaid 11.3+"
      ]
    },
    {
      "dot": "cyan",
      "title": "Relationship Vocabulary",
      "items": [
        "Arrow, open, dotted, thick, invisible, circle, and cross links",
        "Edge labels and additional dashes control meaning and minimum rank",
        "Edge IDs enable per-edge animation and curve configuration"
      ]
    },
    {
      "dot": "amber",
      "title": "Composition and guardrails",
      "items": [
        "Subgraphs may set direction; classes style nodes; Markdown formats labels.",
        "Interactions need compatible security settings.",
        "Avoid lowercase end and unspaced o/x after links; quote syntax-sensitive labels.",
        "Put %% comments on their own lines."
      ]
    }
  ]
}
