{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Code Walkthrough Workflow",
    "subtitle": "Evidence-first tracing from a user request to a verified execution narrative",
    "animation": "none",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "viewBox": [720, 820]
  },
  "lanes": [
    { "id": "request", "label": "Request" },
    { "id": "discovery", "label": "Code Discovery" },
    { "id": "trace", "label": "Execution Trace" },
    { "id": "output", "label": "Walkthrough" },
    { "id": "evidence", "label": "Evidence Check", "variant": "exception" }
  ],
  "phases": [
    { "id": "scope", "label": "Scope", "fromCol": 0, "toCol": 0 },
    { "id": "locate", "label": "Locate", "fromCol": 1, "toCol": 2 },
    { "id": "follow", "label": "Follow execution", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "explain", "label": "Explain", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "walkthrough_request",
    "resolve_target",
    "verify_entry",
    "read_chain",
    "trace_behavior",
    "publish_walkthrough"
  ],
  "nodes": [
    {
      "id": "walkthrough_request",
      "lane": "request",
      "col": 0,
      "type": "external",
      "label": "Request",
      "sublabel": "feature or code target"
    },
    {
      "id": "resolve_target",
      "lane": "discovery",
      "col": 1,
      "type": "frontend",
      "label": "Target",
      "width": 40
    },
    {
      "id": "verify_entry",
      "lane": "discovery",
      "col": 2,
      "type": "backend",
      "label": "Entry",
      "width": 40
    },
    {
      "id": "read_chain",
      "lane": "trace",
      "col": 3,
      "type": "backend",
      "label": "Read",
      "width": 40
    },
    {
      "id": "trace_behavior",
      "lane": "trace",
      "col": 4,
      "type": "backend",
      "label": "Trace",
      "width": 40
    },
    {
      "id": "evidence_gap",
      "lane": "evidence",
      "col": 4,
      "type": "security",
      "label": "Gap?",
      "width": 40
    },
    {
      "id": "inspect_more",
      "lane": "evidence",
      "col": 3,
      "type": "messagebus",
      "label": "More",
      "width": 40
    },
    {
      "id": "publish_walkthrough",
      "lane": "output",
      "col": 5,
      "type": "cloud",
      "label": "Walkthrough",
      "sublabel": "verified flow"
    }
  ],
  "edges": [
    { "id": "request_to_target", "from": "walkthrough_request", "to": "resolve_target", "role": "main" },
    { "id": "target_to_entry", "from": "resolve_target", "to": "verify_entry", "role": "main" },
    { "id": "entry_to_chain", "from": "verify_entry", "to": "read_chain", "role": "main" },
    { "id": "chain_to_behavior", "from": "read_chain", "to": "trace_behavior", "role": "main", "variant": "emphasis" },
    { "id": "behavior_to_check", "from": "trace_behavior", "to": "evidence_gap", "role": "branch", "variant": "security" },
    { "id": "gap_to_inspection", "from": "evidence_gap", "to": "inspect_more", "role": "error", "variant": "security" },
    { "id": "inspection_to_chain", "from": "inspect_more", "to": "read_chain", "role": "return", "variant": "dashed" },
    { "id": "behavior_to_output", "from": "trace_behavior", "to": "publish_walkthrough", "role": "main", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Trace Each Stage",
      "items": [
        "Who calls it and what it calls",
        "Inputs, outputs, and transformations",
        "Validation, branches, and early returns",
        "External calls, side effects, and exceptions"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence Rules",
      "items": [
        "Verify entry points from source and configuration",
        "Read implementations instead of trusting names",
        "Follow the architecture that actually exists",
        "Do not fill missing links with assumptions"
      ]
    }
  ]
}
