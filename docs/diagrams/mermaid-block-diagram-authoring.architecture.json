    {
      "dot": "violet",
      "title": "Placement Model",
      "items": [
        "The author chooses the number of columns",
        "Blocks fill cells in declaration order and wrap into new rows",
        "A numeric suffix spans multiple columns",
        "Column width follows the widest content in that column"
      ]
    },
    {
      "dot": "cyan",
      "title": "Composition",
      "items": [
        "Composite blocks contain their own blocks and column definition",
        "One-column composites create vertical stacks",
        "Space blocks reserve empty cells without adding visible content"
      ]
    },
    {
      "dot": "amber",
      "title": "Visual Vocabulary",
      "items": [
        "Rectangles, rounded blocks, stadiums, subroutines, cylinders, circles, decisions, and more",
        "Block arrows show right, left, up, down, or compound direction",
        "Edges may be directed, open, or labeled"
      ]
    },
    {
      "dot": "rose",
      "title": "Maintenance Rules",
      "items": [
        "Use classes for repeated styling and style for isolated emphasis",
        "Keep complex diagrams modular with nested blocks",
        "Use comments to explain non-obvious placement",
        "Incorrect links or malformed CSS property syntax can break rendering"
      ]
    }
  ]
